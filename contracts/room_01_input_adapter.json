{
  "contract_id": "ROOM_01_INPUT_ADAPTER_V2",
  "room": "LAYER_1_ROOM_01",
  "implementation": "quant/input_adapter.py",
  "role": "RAW_INPUT_ADMISSION_ONLY",
  "format": "NDJSON",
  "record_schema": {
    "day": "YYYY-MM-DD",
    "source_id": "non-empty string",
    "values": "non-empty integer list; each value 0..99",
    "raw_sha256": "64 lowercase hex characters; upstream exact raw-artifact identity"
  },
  "window": {
    "max_days": 30,
    "lookahead": false,
    "date_alignment": true,
    "index_alignment": false,
    "sorting": false
  },
  "admission": {
    "blank_line": "DENY",
    "malformed_json": "DENY",
    "schema_drift": "DENY",
    "bad_date": "DENY",
    "future_date": "DENY",
    "value_out_of_domain": "DENY",
    "raw_hash_invalid": "DENY",
    "raw_hash_expectation": "UPSTREAM_REQUIRED",
    "duplicate_or_non_causal_day": "DENY",
    "oversized_record": "DENY",
    "synthetic_fill": false
  },
  "authority": "OBSERVATION_ONLY",
  "promotion": "FORBIDDEN",
  "memory": {
    "streaming": true,
    "bulk_load": false,
    "max_line_bytes": 16384
  },
  "forensic_rule": "PASS_AT_ROOM_01_IS_PREREQUISITE_ONLY;NO_PASS_INHERITANCE"
}
